years<- list(2014,2019,2024)

#Generar tablas

PuertoRicocensus<- map_dfr(
  years,
  ~   get_acs(
    geography = "state",
    state = "PR",
    variables = vars,
    year = .x,
    survey = "acs5",
    output="wide"),
  .id = "year") 

PuertoRico_municipio_census<- map_dfr(
  years,
  ~   get_acs(
    geography = "county",
    state = "PR",
    variables = vars,
    year = .x,
    survey = "acs5",
    output="wide"),
  .id = "year")

PuertoRico_tract_census<- map_dfr(
  years,
  ~   get_acs(
    geography = "tract",
    state = "PR",
    variables = vars,
    year = .x,
    survey = "acs5",
    output="wide"),
  .id = "year")

PuertoRico_barrio_census<- map_dfr(
  years,
  ~   get_acs(
    geography = "county subdivision",
    state = "PR",
    county = "Ponce",
    variables = varstarea2,
    year = .x,
    survey = "acs5",
    output="wide"),
  .id = "year")



PuertoRicocensus$year= as.numeric(PuertoRicocensus$year)+2009
